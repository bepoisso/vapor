    "i18next": "^27.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@eslint/js": "^9",
